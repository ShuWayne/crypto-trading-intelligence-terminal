# Crypto Trading Intelligence Terminal — environment configuration
# Copy to .env and adjust. No secrets are needed: this project uses
# Binance PUBLIC market data only and has no API keys, no auth, and no
# live-trading execution path. Never put an API key in this file.

# Server port (production: the server serves the API + client/dist)
PORT=3001

# Vite dev-server port (development only)
CLIENT_PORT=5173

# Binance public REST endpoint (official public-data endpoint;
# api.binance.com is geo-blocked on some networks).
# Fallback if this fails: https://api.binance.us
BINANCE_REST_BASE=https://data-api.binance.vision

# Binance public WebSocket endpoint (live tickers).
# If WS fails, the server falls back to REST polling every 5s (DEGRADED).
BINANCE_WS_URL=wss://stream.binance.com:9443

# SQLite database file (created on first run; seed settings:
# dailyLossLimit=25, riskPerTrade=15)
DB_PATH=./server/data/terminal.db

# Paper-trading risk settings (validated values — changing them means
# paper trading no longer tests the validated v3-B design)
PAPER_RISK_PER_TRADE=15
PAPER_DAILY_LOSS_LIMIT=25
